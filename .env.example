# ============================================================
# 环境变量示例 —— 复制为 .env 后填写，切勿提交 .env
# ============================================================

# ---------- 应用 ----------
APP_ENV=development          # development | staging | production
APP_DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=                  # 必填：随机生成 openssl rand -hex 32

# ---------- ComfyUI 引擎 ----------
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_WS_TIMEOUT=600       # 单任务超时（秒）
COMFYUI_MAX_CONCURRENCY=1    # 单卡并发上限，由 P9-03 探测后确定
COMFYUI_MODELS_PATH=/path/to/ComfyUI/models

# ---------- 数据库 ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=comfyui_platform
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------- Redis / 队列 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_QUEUE_DEFAULT=default
CELERY_QUEUE_HIGH=high

# ---------- 对象存储（MinIO / S3） ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_ASSETS=assets
S3_BUCKET_OUTPUTS=outputs
S3_USE_SSL=false

# ---------- 存储生命周期 ----------
OUTPUT_RETENTION_DAYS=30     # 产物保留天数，过期清理

# ---------- 配额与限流 ----------
RATE_LIMIT_PER_MINUTE=60
DEFAULT_USER_QUOTA_PER_DAY=500

# ---------- 监控 ----------
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# ---------- LLM（V2 预留，V1 不启用） ----------
# LLM_API_BASE=
# LLM_API_KEY=
