# ============================================================
# 环境变量示例 —— 复制为 .env 后按需填写；**切勿提交 .env 本身**
#
# ⚠️ 变量名与 `backend/app/core/config.py` 的 `Settings` 字段**逐一对应**
#    （字段名大写即变量名，大小写不敏感）。
#    配置装载用的是 pydantic-settings 且 `extra="ignore"` ——
#    **写错名字不会报错，只会被静默忽略并沿用默认值**，所以务必照抄本文件的变量名。
#
#    防漂移：`backend/tests/test_env_example.py` 会断言本文件与 `Settings.model_fields`
#    双向一一对应。加了新配置项却没更新本文件时，那条测试会红。
#
# 本文件已列全全部 64 项。标【勿手工设置】的是代码内常量或派生值，
# **列出来是为了说明"它存在、但不该由客户改"**，省略反而会让人以为不支持。
# ============================================================

# ---------- 应用 ----------
ENV=dev                              # dev | staging | prod
DEBUG=false
API_V1_PREFIX=/api/v1
APP_NAME=电商视觉 AIGC 量产平台        # 【勿手工设置】代码内常量，随产品名变化
APP_VERSION=0.1.0                    # 【勿手工设置】代码内常量，与包版本同步

# ---------- 数据库（PostgreSQL） ----------
# 完整 SQLAlchemy 连接串。生产必须改密码；本地开发可改 SQLite（如 sqlite+pysqlite:///./dev.db）
DATABASE_URL=postgresql+psycopg://platform:platform@127.0.0.1:5432/platform
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false                        # true 会把每条 SQL 打到日志，仅排障时开

# ---------- Redis / 队列 ----------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------- 对象存储（MinIO / S3 兼容） ----------
MINIO_ENDPOINT=127.0.0.1:9000         # 注意：**不带** http:// 前缀
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false                    # 走 HTTPS 时设 true
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_OUTPUTS=outputs

# ---------- ComfyUI 推理引擎 ----------
# 安全红线（NFR-4）：ComfyUI 无鉴权，**只允许本机访问**，不要指向公网地址。
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
COMFYUI_CONNECT_TIMEOUT=5.0
COMFYUI_READ_TIMEOUT=30.0
COMFYUI_OUTPUT_DIR=/root/autodl-tmp/comfyui-data/output   # 兜底取图用

# ---------- 安全 ----------
# 必填：openssl rand -hex 32。留空则沿用 CHANGE_ME_IN_ENV，启动时会告警。
JWT_SECRET=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080     # 7 天
BCRYPT_ROUNDS=12

# ---------- 上传边界（PRD §6.2） ----------
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_MIN_KB=100
MIN_IMAGE_SIDE=64
MAX_IMAGE_SIDE=8192

# ---------- 批量与生成边界（PRD §6.2） ----------
MAX_BATCH_SIZE=1000                   # **总张数**上限
MAX_SKU_COUNT=1000                    # **SKU 数**上限（冗余护栏，勿设得比 MAX_BATCH_SIZE 更严）
MIN_PROMPT_LENGTH=1
MAX_PROMPT_LENGTH=2000
MIN_STEPS=1
MAX_STEPS=100
MIN_CFG=1.0
MAX_CFG=20.0
MIN_GEN_SIDE=512
MAX_GEN_SIDE=2048

# ---------- 内容安全（P6-13） ----------
# 输入侧敏感词/合规词过滤总开关。词表：backend/app/data/content_blocklist.json
# ⚠️ false = 完全不检查（不拦、也不写审计）；⚠️ 它**不**含 NSFW 视觉检测 ——
#    那部分 V1 未实现，打开本开关不会让任何图片被检测。
CONTENT_SAFETY_ENABLED=true

# ---------- 重试与超时 ----------
TASK_MAX_RETRIES=3
TASK_MAX_RETRIES_HARD_LIMIT=5
TASK_TIMEOUT_SECONDS=300
TASK_TIMEOUT_MIN=60
TASK_TIMEOUT_MAX=600
TASK_HEARTBEAT_TIMEOUT_SECONDS=300    # 僵尸任务判定（T14）
QUEUE_MAX_DEPTH=10000

# ---------- 队列与并发（NFR-2：GPU 并发恒为 1） ----------
# GPU_LOCK_TTL_SECONDS 必须 > TASK_TIMEOUT_MAX，否则长任务会被误判为"锁已过期"
GPU_LOCK_KEY=comfyui:gpu_slot
GPU_LOCK_WAIT_SECONDS=60
GPU_LOCK_TTL_SECONDS=900
TASK_RETRY_BACKOFF_SECONDS=10
TASK_RETRY_BACKOFF_MAX_SECONDS=120
ORPHAN_REQUEUE_SECONDS=300            # 兜底扫描：多久没被消费就重新投递
ORPHAN_REQUEUE_LIMIT=200
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_VRAM_SAMPLE_SECONDS=2.0

# ---------- 资源保护（EX-4） ----------
DISK_MIN_FREE_GB=5
DISK_WARN_FREE_GB=10

# ---------- 素材与产物的生命周期（P6-10） ----------
# 回收站保留期：软删除后超过它才**物理**删除（对象 + 记录）。误删挽回窗口。
ASSET_TRASH_RETENTION_DAYS=30
# 产物保留期。**0 = 永久保留**（V1 默认）。产物是用户花钱生成的资产，别轻易让它过期。
# 注意：即使设为非 0，已采纳 / 已收藏的产物也永不清理。
ASSET_OUTPUT_RETENTION_DAYS=0
MAX_PACK_ASSETS=200                   # 单次打包下载张数上限（内存/磁盘护栏，非业务规则）
CLEANUP_BATCH_LIMIT=500               # 每轮清理最多处理条数（避免占满 DB 连接）

# ---------- 配额与优先级 ----------
DEFAULT_QUOTA_TOTAL=50                # 新用户赠送额度（免信用卡 + 送额度）
DEFAULT_PRIORITY=5                    # 1（最高）~ 9（最低）

# ---------- 可观测 ----------
LOG_LEVEL=INFO
LOG_JSON=true                         # 生产用 JSON，本地可设 false 便于阅读

# ---------- 成本模型（FR-7.5） ----------
# 留 0 = 关闭成本计算（estimated_cost_yuan 会返回 null）。填真实单价后自动生效。
GPU_COST_PER_HOUR=0.0
