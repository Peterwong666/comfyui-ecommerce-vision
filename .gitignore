# ============================================================
# ComfyUI 商用封装平台 · .gitignore
# 原则：代码与文档入库，数据/模型/产物/密钥一律不入库
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- 环境变量与密钥（红线） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json
service_account.json

# ---------- 模型权重（体积巨大 + 许可敏感，只入库 registry 清单） ----------
# ⚠️ 必须用**根锚定**（前导 /）：不锚定的 `models/` 会匹配任意层级的同名目录，
#    曾把源码目录 `backend/app/models/`（8 个 ORM 模型文件）整个挡在仓库之外，
#    导致 clone 下来后端无法 import。改这几条时务必保留前导斜杠。
/models/
/assets/models/
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.gguf
*.onnx
*.engine
*.fp8
*.lora

# ---------- 运行时产物（同样必须根锚定，理由同上） ----------
/output/
/outputs/
/input/
/temp/
/tmp/
/uploads/
/storage/
*.log
# 夜间任务的收工日志（`*.log` 其实已覆盖；这条是显式化，便于按名字 grep 到）
nightly-*.log
/logs/

# ---------- 证据例外 ----------
# deploy/ 下的 evidence 目录存放「过程可证明」所需的**原始凭据**（节点审计日志、
# 安装错误日志等）。这些是台账里每条判定的追溯依据，必须入库，否则结论无法被第三方复核。
# 只对 *.log 开例外 —— 其余扩展名（.txt/.md/.json）本就不在忽略范围内。
#
# ⚠️ 这里的 `**` 不能省：`deploy/**/evidence/` 是两层，证据文件常放在
#   `evidence/<批次名>/xxx.log`（中间还有一层），所以 `evidence/` 之后还要再一个 `**`。
#   历史事故：本行原写作 `!deploy/**/evidence/*.log`，匹配不到
#   `deploy/comfyui/evidence/golden_set_20260918/39_golden_set_run.log`，
#   导致该文件"已被追踪、又被忽略"（`test_repo_hygiene.py` 的
#   `test_no_tracked_file_is_ignored_by_gitignore` 一直在报红）。2026-09-23 修正。
!deploy/**/evidence/**/*.log
# 仓库根 evidence/ 是同类证据目录（P4 控制体系实测等），同样开 *.log 例外。
!evidence/**/*.log

# ---------- 数据库与对象存储 ----------
*.db
*.sqlite
*.sqlite3
postgres_data/
redis_data/
minio_data/

# ---------- 前端 ----------
node_modules/
web/node_modules/
web/dist/
web/.vite/
web/coverage/
.pnpm-store/

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ---------- 测试用例中的敏感图（按需白名单） ----------
tests/golden_set/reference/*
!tests/golden_set/reference/.gitkeep

# ---------- 探针/验证的产物图（可重生，数值证据见 项目进展.md 台账）----------
/g7_probe_out/
/render_l4_out/
/bench_out/
/verify_out/

# ---------- GPU 生成的大型证据图片（本地保留，不入 GitHub）----------
deploy/comfyui/evidence/**/*.png
deploy/comfyui/evidence/**/*.jpg
evidence/p4_control_*/
evidence/p4_union_cn_*/
evidence/gpu_test_*/
# 保留 README 截图（< 1MB）
!evidence/screenshots/

# ---------- 洗稿/编辑临时备份（防误提交）----------
*.pre-clean.bak
*.docx.bak
