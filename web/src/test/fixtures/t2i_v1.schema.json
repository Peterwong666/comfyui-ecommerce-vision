{
  "schema_version": 1,
  "fields": [
    {
      "key": "prompt",
      "label": "正向提示词",
      "type": "text",
      "default": "professional product photo of a ceramic coffee mug, matte white finish, on a light grey seamless background, soft studio lighting, subtle shadow, sharp focus, high detail, centered composition",
      "max_length": 2000,
      "group": "提示词",
      "help": "描述商品与场景。建议包含：主体 + 背景 + 光线 + 视角",
