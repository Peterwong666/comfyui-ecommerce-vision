      "max_length": 2000,
      "group": "提示词",
      "advanced": true,
      "help": "不想出现的内容。SDXL 需要 cfg>1 才生效",
      "targets": [
        {
          "node_id": "7",
          "input": "text"
        }
      ]
    },
    {
      "key": "width",
