{
  "schema_version": 1,
  "fields": [
    {
      "key": "reference_image",
      "label": "原图",
      "type": "image",
      "default": 0,
      "group": "输入",
      "help": "待重绘的原图（素材 id）。**必须提供**；重绘区 = 该图的**透明区域**（蒙版极性待 GPU 实测确认，见 verification_note）",
      "targets": [
        {
          "node_id": "10",
          "input": "image",
          "transform": "ref_to_filename"
        }
      ]
    },
    {
      "key": "prompt",
      "label": "正向提示词",
      "type": "text",
      "default": "professional product photo, on a light grey seamless background, soft studio lighting, subtle shadow, sharp focus, high detail",
      "max_length": 2000,
      "group": "提示词",
      "help": "描述**重绘区**应该长什么样（非选区不受影响）",
      "targets": [
        {
          "node_id": "11",
          "input": "text"
        }
      ]
    },
    {
      "key": "negative_prompt",
      "label": "负向提示词",
      "type": "text",
      "default": "blurry, low quality, distorted, deformed, watermark, text, logo, cropped, oversaturated, plastic look",
      "max_length": 2000,
      "group": "提示词",
      "advanced": true,
      "targets": [
        {
          "node_id": "12",
          "input": "text"
        }
      ]
    },
    {
      "key": "mask_expand",
      "label": "蒙版扩张",
      "type": "int",
      "default": 8,
      "min": -32,
      "max": 128,
      "step": 1,
      "group": "蒙版",
      "help": "正数向外扩张蒙版（像素）。适度扩张可让接缝更自然；负数为收缩",
      "targets": [
        {
          "node_id": "14",
          "input": "expand"
        }
      ]
    },
    {
      "key": "width",
      "label": "宽度",
      "type": "int",
      "default": 1024,
      "min": 512,
      "max": 2048,
      "step": 64,
      "group": "画布",
      "help": "输出尺寸；原图会被缩放到该尺寸（长边受 PRD §6.2 约束 512–2048）",
      "targets": [
        {
          "node_id": "13",
          "input": "width"
        }
      ]
    },
    {
      "key": "height",
      "label": "高度",
      "type": "int",
      "default": 1024,
      "min": 512,
      "max": 2048,
      "step": 64,
      "group": "画布",
      "targets": [
        {
          "node_id": "13",
          "input": "height"
        }
      ]
    },
    {
      "key": "denoise",
      "label": "重绘强度",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "group": "采样",
      "help": "蒙版区内完全重画（1.0）。因为只作用于选区、非选区已贴回，通常无需调低",
      "targets": [
        {
          "node_id": "22",
          "input": "denoise"
        }
      ]
    },
    {
      "key": "seed",
      "label": "随机种子",
      "type": "seed",
      "default": -1,
      "group": "采样",
      "help": "-1 表示随机。渲染时解析成真实值并写进产物元数据（FR-5.4/5.5）",
      "targets": [
        {
          "node_id": "22",
          "input": "seed"
        }
      ]
    },
    {
      "key": "steps",
      "label": "采样步数",
      "type": "int",
      "default": 25,
      "min": 1,
      "max": 100,
      "step": 1,
      "group": "采样",
      "advanced": true,
      "help": "SDXL 推荐 20–35",
      "targets": [
        {
          "node_id": "22",
          "input": "steps"
        }
      ]
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "default": 6.5,
      "min": 1.0,
      "max": 20.0,
      "step": 0.1,
      "group": "采样",
      "advanced": true,
      "help": "SDXL 推荐 5–8；过高会过饱和",
      "targets": [
